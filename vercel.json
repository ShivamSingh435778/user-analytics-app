{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/server.js" },
    { "source": "/tracker.js", "destination": "/tracker/tracker.js" },
    { "source": "/dashboard.html", "destination": "/frontend/dashboard.html" },
    { "source": "/demo", "destination": "/frontend/demo.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
